<Window x:Class="NotiRelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotiRelay"
        Icon="Assets/NotiRelay.ico"
        Height="860"
        Width="880"
        MinHeight="560"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Margin="26,24,26,24" MaxWidth="760" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                        <Button x:Name="SendingButton"
                                Content="Stop sending"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,10,0"
                                MinHeight="32"
                                Padding="14,6"
                                AutomationProperties.Name="Stop or resume sending to ntfy"
                                ToolTip="Stop sending anything to ntfy right now, including notifications already waiting."
                                Click="SendingButton_Click"/>
                        <Border x:Name="StatePill"
                                Background="#F1F5F9"
                                CornerRadius="999"
                                Padding="13,7"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot"
                                         Width="9" Height="9" Margin="0,0,8,0"
                                         VerticalAlignment="Center" Fill="#94A3B8"/>
                                <TextBlock x:Name="StateBadge"
                                           Text="STOPPED"
                                           FontWeight="Bold"
                                           FontSize="11.5"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="NotiRelay"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Teams &amp; Outlook → ntfy → your phone"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource CardBorderBrush}"
                            Margin="0,16,0,14"/>

                    <TextBlock Text="Personal notification companion. It forwards Teams messages and Outlook toasts to your phone through ntfy, without a background service."
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="{StaticResource MutedBrush}"/>

                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Checked="StartWithWindows_Toggled"
                              Unchecked="StartWithWindows_Toggled"
                              Margin="0,16,0,0"
                              VerticalContentAlignment="Center"
                              Foreground="{StaticResource InkBrush}">
                        <TextBlock Text="Start automatically when I sign in to Windows (opens in the tray)"
                                   TextWrapping="Wrap" FontSize="12.5"/>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- NTFY -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
                        </Border>
                        <TextBlock Text="ntfy connection" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionDesc}"
                               Text="Enter the topic you subscribed to in the ntfy app on your phone. Anyone who knows the topic can read what is sent to it, so use a long, random one. It is stored encrypted for your Windows account."/>

                    <TextBlock Text="ntfy topic" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="RevealTopicButton"
                                DockPanel.Dock="Right"
                                Content="Show"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                ToolTip="Show or hide what you typed"
                                Click="RevealTopic_Click"/>
                        <Grid>
                            <PasswordBox x:Name="TopicBox"
                                         Margin="0"
                                         AutomationProperties.Name="ntfy topic"
                                         PasswordChanged="TopicInput_Changed"
                                         PreviewKeyDown="TopicInput_PreviewKeyDown"/>
                            <TextBox x:Name="TopicPlainBox"
                                     Margin="0"
                                     Visibility="Collapsed"
                                     AutomationProperties.Name="ntfy topic"
                                     TextChanged="TopicInput_Changed"
                                     PreviewKeyDown="TopicInput_PreviewKeyDown"/>
                            <TextBlock x:Name="TopicPlaceholder"
                                       Text="Paste a topic name or an https://ntfy.sh/… link"
                                       Style="{StaticResource Placeholder}"/>
                        </Grid>
                    </DockPanel>

                    <TextBlock x:Name="TopicSavedLabel"
                               Text="No topic saved yet."
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <WrapPanel>
                        <Button x:Name="SaveTopicButton"
                                Content="Save topic"
                                Style="{StaticResource Primary}"
                                Click="SaveSettings_Click"/>
                        <Button x:Name="TestNtfyButton"
                                Content="Send test"
                                ToolTip="Sends a test notification to every topic in use"
                                Click="TestNtfy_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="NtfyStatus"
                               Style="{StaticResource StatusText}"
                               Margin="0,12,0,0"/>

                    <Border Height="1" Background="{StaticResource CardBorderBrush}"
                            Margin="0,16,0,14"/>

                    <TextBlock Text="Topic per notification type (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Leave a row empty to use the main topic. Send test sends one test to every topic in use."
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Teams messages"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource InkBrush}"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="TopicTeamsBox"
                                     Margin="0"
                                     Tag="Teams"
                                     AutomationProperties.Name="ntfy topic for Teams messages"
                                     TextChanged="CategoryTopic_Changed"/>
                            <TextBlock x:Name="TopicTeamsPlaceholder"
                                       Text="Empty = main topic"
                                       Style="{StaticResource Placeholder}"/>
                        </Grid>
                        <TextBlock x:Name="TopicTeamsState"
                                   Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Caption}"/>
                        <Button x:Name="TopicTeamsClear"
                                Grid.Column="3"
                                Content="Use main"
                                Tag="Teams"
                                Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                ToolTip="Send Teams messages to the main topic again"
                                Click="CategoryTopicClear_Click"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Outlook notifications"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource InkBrush}"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="TopicOutlookBox"
                                     Margin="0"
                                     Tag="Outlook"
                                     AutomationProperties.Name="ntfy topic for Outlook notifications"
                                     TextChanged="CategoryTopic_Changed"/>
                            <TextBlock x:Name="TopicOutlookPlaceholder"
                                       Text="Empty = main topic"
                                       Style="{StaticResource Placeholder}"/>
                        </Grid>
                        <TextBlock x:Name="TopicOutlookState"
                                   Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Caption}"/>
                        <Button x:Name="TopicOutlookClear"
                                Grid.Column="3"
                                Content="Use main"
                                Tag="Outlook"
                                Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                ToolTip="Send Outlook notifications to the main topic again"
                                Click="CategoryTopicClear_Click"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Meetings"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource InkBrush}"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="TopicCalendarBox"
                                     Margin="0"
                                     Tag="Calendar"
                                     AutomationProperties.Name="ntfy topic for Meetings"
                                     TextChanged="CategoryTopic_Changed"/>
                            <TextBlock x:Name="TopicCalendarPlaceholder"
                                       Text="Empty = main topic"
                                       Style="{StaticResource Placeholder}"/>
                        </Grid>
                        <TextBlock x:Name="TopicCalendarState"
                                   Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Caption}"/>
                        <Button x:Name="TopicCalendarClear"
                                Grid.Column="3"
                                Content="Use main"
                                Tag="Calendar"
                                Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                ToolTip="Send Meetings to the main topic again"
                                Click="CategoryTopicClear_Click"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Power &amp; battery"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource InkBrush}"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="TopicBatteryBox"
                                     Margin="0"
                                     Tag="Battery"
                                     AutomationProperties.Name="ntfy topic for Power &amp; battery"
                                     TextChanged="CategoryTopic_Changed"/>
                            <TextBlock x:Name="TopicBatteryPlaceholder"
                                       Text="Empty = main topic"
                                       Style="{StaticResource Placeholder}"/>
                        </Grid>
                        <TextBlock x:Name="TopicBatteryState"
                                   Grid.Column="2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Caption}"/>
                        <Button x:Name="TopicBatteryClear"
                                Grid.Column="3"
                                Content="Use main"
                                Tag="Battery"
                                Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                ToolTip="Send Power &amp; battery to the main topic again"
                                Click="CategoryTopicClear_Click"/>
                    </Grid>

                    <WrapPanel Margin="0,4,0,0">
                        <Button x:Name="SaveCategoryTopicsButton"
                                Content="Save topics"
                                Click="SaveCategoryTopics_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="CategoryTopicsStatus"
                               Style="{StaticResource StatusText}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- TEAMS INBOX -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
                        </Border>
                        <TextBlock Text="Microsoft Teams integration" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionDesc}"
                               Text="Monitor the locally synchronized OneDrive folder that receives Teams messages from a Power Automate flow."/>

                    <TextBlock Text="Teams inbox folder" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="Browse…"
                                Margin="8,0,0,0"
                                Click="BrowseTeamsInbox_Click"/>
                        <Grid>
                            <TextBox x:Name="TeamsInboxPathBox"
                                     IsReadOnly="True"
                                     AutomationProperties.Name="Teams inbox folder"
                                     TextChanged="TeamsInboxPath_Changed"
                                     Margin="0"/>
                            <TextBlock x:Name="TeamsInboxPlaceholder"
                                       Text="No folder selected. Press Browse… to pick the synced inbox folder."
                                       Style="{StaticResource Placeholder}"/>
                        </Grid>
                    </DockPanel>

                    <WrapPanel>
                        <Button x:Name="StartTeamsInboxButton"
                                Content="Start Teams monitoring"
                                Style="{StaticResource Primary}"
                                Click="StartTeamsInbox_Click"/>
                        <Button x:Name="StopTeamsInboxButton"
                                Content="Stop Teams monitoring"
                                IsEnabled="False"
                                Click="StopTeamsInbox_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="TeamsInboxStatus"
                               Text="Teams inbox monitoring is stopped."
                               Style="{StaticResource StatusText}"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Power Automate → OneDrive → NotiRelay"
                               Style="{StaticResource Caption}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- OUTLOOK (WINDOWS NOTIFICATION LISTENER) -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
                        </Border>
                        <TextBlock Text="Outlook notifications" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionDesc}"
                               Text="Optional. Forward Outlook desktop notifications (Windows toasts) through the Windows notification listener. This works independently of the Teams integration above."/>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                        <CheckBox x:Name="AuthorizationCheckBox"
                                  Checked="OutlookConsent_Toggled"
                                  Unchecked="OutlookConsent_Toggled"
                                  Foreground="{StaticResource InkBrush}">
                            <TextBlock Text="I confirm that I want to forward notifications detected by this Windows listener to my ntfy topic. (Remembered; untick to stop.)"
                                       TextWrapping="Wrap" FontSize="12.5"/>
                        </CheckBox>
                    </Border>

                    <WrapPanel>
                        <Button x:Name="StartButton"
                                Content="Start Outlook monitoring"
                                Style="{StaticResource Primary}"
                                Click="Start_Click"/>
                        <Button x:Name="StopButton"
                                Content="Stop Outlook monitoring"
                                IsEnabled="False"
                                Click="Stop_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="ListenerStatus"
                               Text="Outlook monitoring is stopped."
                               Style="{StaticResource StatusText}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- OUTLOOK CALENDAR -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="4" Style="{StaticResource StepNumber}"/>
                        </Border>
                        <TextBlock Text="Outlook calendar" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionDesc}"
                               Text="Optional. Sends your meetings to the phone: new, moved or cancelled meetings within about 15 seconds, today's agenda at 08:45, and a reminder 10 minutes before each meeting. Reads the classic Outlook on this PC while it is open. Meeting titles and times go through ntfy; nothing is copied into another calendar."/>

                    <WrapPanel>
                        <Button x:Name="StartCalendarButton"
                                Content="Start calendar"
                                Style="{StaticResource Primary}"
                                Click="StartCalendar_Click"/>
                        <Button x:Name="StopCalendarButton"
                                Content="Stop calendar"
                                IsEnabled="False"
                                Click="StopCalendar_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="CalendarStatus"
                               Text="Outlook calendar is stopped."
                               Style="{StaticResource StatusText}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- POWER & BATTERY -->
            <Border Grid.Row="5" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="5" Style="{StaticResource StepNumber}"/>
                        </Border>
                        <TextBlock Text="Power &amp; battery" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionDesc}"
                               Text="Optional. Sends an alert when the laptop battery drops to 30% and again at 10% while it is not charging."/>

                    <CheckBox x:Name="BatteryAlertsCheckBox"
                              Checked="BatteryAlerts_Toggled"
                              Unchecked="BatteryAlerts_Toggled"
                              Foreground="{StaticResource InkBrush}">
                        <TextBlock Text="Send low-battery alerts (remembered)" FontSize="12.5"/>
                    </CheckBox>

                    <TextBlock x:Name="BatteryStatusText"
                               Text="Low-battery alerts are off."
                               Style="{StaticResource StatusText}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- ACTIVITY LOG -->
            <Border Grid.Row="6" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="DebugButton"
                                    Content="Debugging"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,6,0"
                                    AutomationProperties.Name="Debugging"
                                    Click="DebugButton_Click"/>
                            <Button x:Name="ShowDebugFileButton"
                                    Content="Show file"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed"
                                    ToolTip="Show the debug log in File Explorer"
                                    Click="ShowDebugFile_Click"/>
                            <Button Content="Copy"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,6,0"
                                    ToolTip="Copy the whole log to the clipboard"
                                    Click="CopyLog_Click"/>
                            <Button Content="Clear"
                                    Style="{StaticResource SmallButton}"
                                    ToolTip="Clear the log on screen"
                                    Click="ClearLog_Click"/>
                        </StackPanel>
                        <TextBlock Text="Activity log" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <Border Background="#0F172A" CornerRadius="10" Padding="4" Height="240">
                        <ListBox x:Name="ActivityList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#CBD5E1"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 AutomationProperties.Name="Activity log"
                                 ItemContainerStyle="{StaticResource LogItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>

            <!-- FOOTER -->
            <TextBlock x:Name="FooterText"
                       Grid.Row="7"
                       Text="NotiRelay · personal Teams and Outlook notification relay"
                       Style="{StaticResource Caption}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>
