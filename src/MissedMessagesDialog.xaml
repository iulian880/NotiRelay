<Window x:Class="NotiRelay.MissedMessagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotiRelay"
        Icon="Assets/NotiRelay.ico"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{StaticResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Border Style="{StaticResource Card}" Margin="16" Padding="24">
        <StackPanel>
            <!-- Warning band: nothing is sent until this is answered -->
            <Border Background="#FEF3C7"
                    BorderBrush="#F59E0B"
                    BorderThickness="4,0,0,0"
                    CornerRadius="6"
                    Padding="12,9"
                    Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠"
                               FontSize="16"
                               Foreground="#B45309"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="HeadingText"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#92400E"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="QuestionText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       LineHeight="22"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource InkBrush}"/>

            <TextBlock x:Name="DetailsText"
                       Style="{StaticResource StatusText}"
                       Foreground="{StaticResource InkBrush}"
                       Margin="0,10,0,0"/>

            <TextBlock x:Name="NoteText"
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="YesButton"
                        Style="{StaticResource Primary}"
                        MinWidth="120"
                        Click="Yes_Click"/>
                <Button x:Name="NoButton"
                        MinWidth="120"
                        Margin="0"
                        IsCancel="True"
                        Click="No_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
