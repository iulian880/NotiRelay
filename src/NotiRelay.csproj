
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <AssemblyName>NotiRelay</AssemblyName>
    <RootNamespace>NotiRelay</RootNamespace>

    <ApplicationTitle>NotiRelay</ApplicationTitle>
    <Product>NotiRelay</Product>
    <Description>Personal notification forwarding utility.</Description>
    <Company>Personal Software</Company>
    <Authors>Personal Software</Authors>

    <ApplicationIcon>Assets\NotiRelay.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\NotiRelay.ico" />
  </ItemGroup>
</Project>
